# Als .env neben compose.yaml ablegen. Secrets erzeugen (siehe docs/SYNOLOGY.md). Niemals echte Werte committen.
FILLENS_VERSION=0.7.0
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
COOKIE_SECURE=true
SESSION_HOURS=12
BIND_ADDRESS=127.0.0.1
PORT=3000
FTP_POLL_SECONDS=60
FTP_SETTLE_SECONDS=30
FTP_TIMEOUT_SECONDS=20
MAX_IMAGE_BYTES=15728640
MAX_SCAN_FILES=10000
MAX_IMPORTS_PER_CYCLE=100
